#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"
IDI_KEYPULSE ICON "icon\\keypulse.ico"
IDR_KEYPRESS_100 RCDATA "icon\\key-press-100.png"
IDR_KEYPRESS_50  RCDATA "icon\\key-press-50.png"

1 VERSIONINFO
 FILEVERSION 0,0,2,0
 PRODUCTVERSION 0,0,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "KeyPulse keyboard frequency visualizer\0"
            VALUE "FileVersion", "0.0.2\0"
            VALUE "InternalName", "KeyPulse\0"
            VALUE "OriginalFilename", "KeyPulse.exe\0"
            VALUE "ProductName", "KeyPulse\0"
            VALUE "ProductVersion", "0.0.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
